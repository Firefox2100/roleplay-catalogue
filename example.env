# Application Server Configuration
RC_APP_HOST=127.0.0.1
RC_APP_PORT=9798
RC_LOGGING_LEVEL=INFO
# Use /api when this service is exposed directly alongside the frontend.
RC_API_PREFIX=
# Optional path to a built Vite directory. Leave blank when a proxy serves the frontend.
RC_FRONTEND_DIST_PATH=

# MongoDB Configuration
RC_MONGODB_HOST=127.0.0.1
RC_MONGODB_PORT=27017
RC_MONGODB_NAME=roleplay-catalogue
RC_MONGODB_DIRECT_CONNECTION=false
# Required for atomic multi-document publication/deletion. MongoDB must run as
# a replica set (a single-node replica set is sufficient for local use).
RC_MONGODB_REPLICA_SET=rs0
# Internal credential used by the optional Community Search (mongot) process.
MONGOT_PASSWORD=replace-with-a-long-random-password

# S3-compatible Storage Configuration
RC_S3_ENDPOINT_URL=http://127.0.0.1:9000
RC_S3_REGION=us-east-1
RC_S3_ACCESS_KEY_ID=minioadmin
RC_S3_SECRET_ACCESS_KEY=minioadmin
RC_S3_BUCKET=roleplay-catalogue
RC_IMAGE_MAX_BYTES=20971520

# SMTP Configuration
RC_SMTP_HOST=127.0.0.1
RC_SMTP_PORT=1025
RC_SMTP_USERNAME=
RC_SMTP_PASSWORD=
RC_SMTP_USE_TLS=false
RC_SMTP_START_TLS=false
RC_SMTP_SENDER=no-reply@localhost

# Email and Public URLs
RC_PUBLIC_BASE_URL=http://127.0.0.1:5173

# Session Configuration
RC_ACTIVATION_TOKEN_MAX_AGE=86400
RC_PENDING_ACCOUNT_RETENTION=86400
RC_ACCOUNT_CLEANUP_INTERVAL=21600
RC_PASSWORD_RESET_TOKEN_MAX_AGE=3600
RC_API_KEY_CLEANUP_INTERVAL=21600
RC_SESSION_SECRET=your-secret-key-here-minimum-32-bytes-recommended
RC_SESSION_COOKIE_NAME=roleplay_catalogue_session
RC_SESSION_MAX_AGE=1209600
RC_SESSION_COOKIE_SECURE=false

# Browser Security Headers
RC_SECURITY_HEADERS_ENABLED=true
# Override when the frontend intentionally loads assets or connects to other origins.
RC_CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
# HSTS must only be enabled on an HTTPS-only deployment. Zero keeps it disabled.
RC_HSTS_MAX_AGE=0
RC_HSTS_INCLUDE_SUBDOMAINS=false
RC_HSTS_PRELOAD=false
# Used by the all-in-one Nginx container. Example HTTPS-only value:
# max-age=31536000; includeSubDomains
NGINX_HSTS_HEADER=
# Optional container-level override for the frontend response CSP.
NGINX_CONTENT_SECURITY_POLICY=
